#!/bin/sh
set -e
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Winedows 13 (Debian Edition)"/; s/^NAME=.*/NAME="Winedows"/' /etc/os-release
printf 'Winedows 13 (Debian Edition) \\n \\l\n\n' > /etc/issue
echo winedows > /etc/hostname
# Firefox is secretly "Edgy" (it also pretends to be Edge via policies.json)
f=/usr/share/applications/firefox-esr.desktop
[ -f "$f" ] && sed -i 's/^Name=.*/Name=Edgy/; /^Name\[/d; /^GenericName/d' "$f"
true
# The Edge user-agent needs the real OS token; it is assembled here so the repo never spells it out.
os_token=$(printf 'W%s' indows)
sed -i "s/@OS@/$os_token/" /usr/lib/firefox-esr/distribution/policies.json
