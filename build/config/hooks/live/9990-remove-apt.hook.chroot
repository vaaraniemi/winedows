#!/bin/sh
# Remove apt. Must stay the LAST hook: nothing after this can install packages.
# dpkg is intentionally kept (see docs/wiki/apt-removal.md).
set -e
apt-get clean || true
pkgs=$(dpkg-query -W -f='${Package} ${db:Status-Abbrev}\n' \
  | awk '$2 ~ /^i/ && $1 ~ /^(apt|apt-utils|apt-listchanges|aptitude|aptitude-common|libapt-pkg[0-9.]*|python3-apt|unattended-upgrades|command-not-found|packagekit.*|software-properties.*|apt-config-.*)$/ {print $1}')
# shellcheck disable=SC2086
dpkg --purge --force-depends --force-remove-essential $pkgs
# live-build still writes /etc/apt/sources.list in later stages (chroot_archives remove),
# so keep empty directories there; only the packages, binaries and data go.
find /etc/apt -mindepth 1 -delete 2>/dev/null || true
mkdir -p /etc/apt/sources.list.d /etc/apt/apt.conf.d /etc/apt/preferences.d
rm -rf /var/lib/apt /var/cache/apt /var/log/apt /usr/lib/apt \
       /usr/share/doc/apt /usr/share/keyrings/debian-archive-*.gpg
rm -f /usr/bin/apt /usr/bin/apt-* /usr/bin/aptitude* /etc/cron.daily/apt-compat
# Fail the build if anything survived
hash -r  # dash caches the path of apt-get from the earlier "apt-get clean"
for c in apt apt-get apt-cache aptitude; do
  for d in /usr/bin /usr/sbin /bin /sbin /usr/local/bin; do
    if [ -e "$d/$c" ]; then echo "FATAL: $d/$c still present" >&2; exit 1; fi
  done
done
echo "apt has been removed. You are welcome."
