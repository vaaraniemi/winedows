[org/cinnamon]
# No taskbar: everything is launched from the Desktop
panels-enabled=@as []
enabled-applets=@as []
favorite-apps=@as []

[org/cinnamon/desktop/background]
picture-uri='file:///usr/share/winedows/wallpapers/01-bedrock.svg'
picture-options='zoom'

[org/cinnamon/desktop/background/slideshow]
# random order every 5 minutes (delay is in minutes); the first wallpaper at login
# is picked at random by /etc/xdg/autostart/winedows-wallpaper.desktop
slideshow-enabled=true
image-source='directory:///usr/share/winedows/wallpapers'
delay=uint32 5
random-order=true

[org/cinnamon/desktop/interface]
gtk-theme='Adwaita'
cursor-theme='Adwaita'
icon-theme='Papirus'
font-name='Liberation Sans 10'

[org/cinnamon/desktop/session]
idle-delay=uint32 0

[org/cinnamon/desktop/screensaver]
lock-enabled=false

[org/nemo/desktop]
computer-icon-visible=true
computer-icon-name='This PC'
trash-icon-visible=true
trash-icon-name='Recycle Bin'
home-icon-visible=true
home-icon-name='Documents'
volumes-visible=false
network-icon-visible=false

[org/nemo/preferences]
executable-text-activation='display'
click-policy='double'

[org/cinnamon/desktop/wm/preferences]
theme='Winedows'
titlebar-font='Liberation Sans 10'
# no minimize: without a taskbar a minimized window is gone for good
button-layout=':maximize,close'
