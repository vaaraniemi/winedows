[org/cinnamon]
panels-enabled=['1:0:bottom']
panels-height=['1:44']
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:grouped-window-list@cinnamon.org:1', 'panel1:right:0:systray@cinnamon.org:2', 'panel1:right:1:network@cinnamon.org:3', 'panel1:right:2:sound@cinnamon.org:4', 'panel1:right:3:calendar@cinnamon.org:5', 'panel1:right:4:show-desktop@cinnamon.org:6']
favorite-apps=['firefox-esr.desktop', 'nemo.desktop']

[org/cinnamon/desktop/background]
picture-uri='file:///usr/share/winedows/wallpaper.svg'
picture-options='zoom'

[org/cinnamon/desktop/interface]
gtk-theme='Adwaita'
icon-theme='Papirus'
font-name='Liberation Sans 10'

[org/cinnamon/desktop/session]
idle-delay=uint32 0

[org/cinnamon/desktop/screensaver]
lock-enabled=false

[org/nemo/desktop]
computer-icon-visible=true
computer-icon-name='This PC'
trash-icon-visible=true
trash-icon-name='Recycle Bin'
home-icon-visible=true
home-icon-name='Documents'
volumes-visible=false
network-icon-visible=false

[org/nemo/preferences]
executable-text-activation='display'
click-policy='double'
