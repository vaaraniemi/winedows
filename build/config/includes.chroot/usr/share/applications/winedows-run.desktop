[Desktop Entry]
Type=Application
Name=Win32 Program Loader
Comment=Runs Win32 programs (the stable ABI)
Exec=/usr/local/bin/winedows-run %f
Icon=wine
NoDisplay=true
MimeType=application/x-ms-dos-executable;application/x-msdos-program;application/x-msi;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-dosexec;
