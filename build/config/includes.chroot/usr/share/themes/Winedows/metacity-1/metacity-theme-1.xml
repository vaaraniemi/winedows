<?xml version="1.0"?>
<!-- Winedows: flat, square, white title bars, blue focus border. Original work (parody look, no third-party artwork). -->
<metacity_theme>
<info><name>Winedows</name><author>Winedows</author><copyright>Winedows parody project</copyright><date>2026</date><description>Flat 10-style window borders</description></info>
<frame_geometry name="normal" title_scale="medium" rounded_top_left="false" rounded_top_right="false" rounded_bottom_left="false" rounded_bottom_right="false">
  <distance name="left_width" value="1"/><distance name="right_width" value="1"/><distance name="bottom_height" value="1"/>
  <distance name="left_titlebar_edge" value="12"/><distance name="right_titlebar_edge" value="0"/>
  <distance name="button_width" value="46"/><distance name="button_height" value="31"/>
  <distance name="title_vertical_pad" value="8"/>
  <border name="title_border" left="0" right="0" top="0" bottom="0"/>
  <border name="button_border" left="0" right="0" top="0" bottom="0"/>
</frame_geometry>
<frame_geometry name="max" parent="normal" has_title="true">
  <distance name="left_width" value="0"/><distance name="right_width" value="0"/><distance name="bottom_height" value="0"/>
</frame_geometry>
<frame_geometry name="border" parent="normal" has_title="false">
  <distance name="title_vertical_pad" value="0"/>
  <distance name="button_width" value="0"/><distance name="button_height" value="0"/>
</frame_geometry>
<draw_ops name="frame_focused"><rectangle color="#ffffff" x="0" y="0" width="width" height="height" filled="true"/><rectangle color="#0a4fd6" x="0" y="0" width="width-1" height="height-1" filled="false"/></draw_ops>
<draw_ops name="title_focused"><title color="#1b1b1f" x="2" y="(height-title_height)/2"/></draw_ops>
<draw_ops name="frame_unfocused"><rectangle color="#ffffff" x="0" y="0" width="width" height="height" filled="true"/><rectangle color="#aaaaaa" x="0" y="0" width="width-1" height="height-1" filled="false"/></draw_ops>
<draw_ops name="title_unfocused"><title color="#808080" x="2" y="(height-title_height)/2"/></draw_ops>
<draw_ops name="blank"></draw_ops>
<draw_ops name="close_normal_focused"><line color="#1b1b1f" x1="width/2-5" y1="height/2-5" x2="width/2+5" y2="height/2+5" width="1"/><line color="#1b1b1f" x1="width/2+5" y1="height/2-5" x2="width/2-5" y2="height/2+5" width="1"/></draw_ops>
<draw_ops name="close_normal_unfocused"><line color="#a0a0a0" x1="width/2-5" y1="height/2-5" x2="width/2+5" y2="height/2+5" width="1"/><line color="#a0a0a0" x1="width/2+5" y1="height/2-5" x2="width/2-5" y2="height/2+5" width="1"/></draw_ops>
<draw_ops name="close_prelight"><rectangle color="#e81123" x="0" y="0" width="width" height="height" filled="true"/><line color="#ffffff" x1="width/2-5" y1="height/2-5" x2="width/2+5" y2="height/2+5" width="1"/><line color="#ffffff" x1="width/2+5" y1="height/2-5" x2="width/2-5" y2="height/2+5" width="1"/></draw_ops>
<draw_ops name="close_pressed"><rectangle color="#f1707a" x="0" y="0" width="width" height="height" filled="true"/><line color="#ffffff" x1="width/2-5" y1="height/2-5" x2="width/2+5" y2="height/2+5" width="1"/><line color="#ffffff" x1="width/2+5" y1="height/2-5" x2="width/2-5" y2="height/2+5" width="1"/></draw_ops>
<draw_ops name="maximize_normal_focused"><rectangle color="#1b1b1f" x="width/2-5" y="height/2-5" width="10" height="10" filled="false"/></draw_ops>
<draw_ops name="maximize_normal_unfocused"><rectangle color="#a0a0a0" x="width/2-5" y="height/2-5" width="10" height="10" filled="false"/></draw_ops>
<draw_ops name="maximize_prelight"><rectangle color="#e5e5e5" x="0" y="0" width="width" height="height" filled="true"/><rectangle color="#1b1b1f" x="width/2-5" y="height/2-5" width="10" height="10" filled="false"/></draw_ops>
<draw_ops name="maximize_pressed"><rectangle color="#cccccc" x="0" y="0" width="width" height="height" filled="true"/><rectangle color="#1b1b1f" x="width/2-5" y="height/2-5" width="10" height="10" filled="false"/></draw_ops>
<draw_ops name="minimize_normal_focused"><line color="#1b1b1f" x1="width/2-5" y1="height/2" x2="width/2+5" y2="height/2" width="1"/></draw_ops>
<draw_ops name="minimize_normal_unfocused"><line color="#a0a0a0" x1="width/2-5" y1="height/2" x2="width/2+5" y2="height/2" width="1"/></draw_ops>
<draw_ops name="minimize_prelight"><rectangle color="#e5e5e5" x="0" y="0" width="width" height="height" filled="true"/><line color="#1b1b1f" x1="width/2-5" y1="height/2" x2="width/2+5" y2="height/2" width="1"/></draw_ops>
<draw_ops name="minimize_pressed"><rectangle color="#cccccc" x="0" y="0" width="width" height="height" filled="true"/><line color="#1b1b1f" x1="width/2-5" y1="height/2" x2="width/2+5" y2="height/2" width="1"/></draw_ops>
<frame_style name="normal_focused" geometry="normal">
  <piece position="entire_background" draw_ops="frame_focused"/>
  <piece position="title" draw_ops="title_focused"/>
  <button function="close" state="normal" draw_ops="close_normal_focused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_normal_focused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_normal_focused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="prelight" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
</frame_style>
<frame_style name="max_focused" geometry="max">
  <piece position="entire_background" draw_ops="frame_focused"/>
  <piece position="title" draw_ops="title_focused"/>
  <button function="close" state="normal" draw_ops="close_normal_focused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_normal_focused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_normal_focused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="prelight" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
</frame_style>
<frame_style name="border_focused" geometry="border">
  <piece position="entire_background" draw_ops="frame_focused"/>
  <piece position="title" draw_ops="title_focused"/>
  <button function="close" state="normal" draw_ops="close_normal_focused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_normal_focused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_normal_focused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="prelight" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
</frame_style>
<frame_style name="normal_unfocused" geometry="normal">
  <piece position="entire_background" draw_ops="frame_unfocused"/>
  <piece position="title" draw_ops="title_unfocused"/>
  <button function="close" state="normal" draw_ops="close_normal_unfocused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_normal_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_normal_unfocused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="prelight" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
</frame_style>
<frame_style name="max_unfocused" geometry="max">
  <piece position="entire_background" draw_ops="frame_unfocused"/>
  <piece position="title" draw_ops="title_unfocused"/>
  <button function="close" state="normal" draw_ops="close_normal_unfocused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_normal_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_normal_unfocused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="prelight" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
</frame_style>
<frame_style name="border_unfocused" geometry="border">
  <piece position="entire_background" draw_ops="frame_unfocused"/>
  <piece position="title" draw_ops="title_unfocused"/>
  <button function="close" state="normal" draw_ops="close_normal_unfocused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_normal_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_normal_unfocused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="prelight" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
</frame_style>
<frame_style_set name="normal">
  <frame focus="yes" state="normal" resize="both" style="normal_focused"/>
  <frame focus="yes" state="normal" resize="vertical_only" style="normal_focused"/>
  <frame focus="yes" state="normal" resize="horizontal_only" style="normal_focused"/>
  <frame focus="yes" state="normal" resize="none" style="normal_focused"/>
  <frame focus="yes" state="shaded" resize="both" style="normal_focused"/>
  <frame focus="yes" state="shaded" resize="vertical_only" style="normal_focused"/>
  <frame focus="yes" state="shaded" resize="horizontal_only" style="normal_focused"/>
  <frame focus="yes" state="shaded" resize="none" style="normal_focused"/>
  <frame focus="yes" state="maximized" style="max_focused"/>
  <frame focus="yes" state="maximized_and_shaded" style="max_focused"/>
  <frame focus="no" state="normal" resize="both" style="normal_unfocused"/>
  <frame focus="no" state="normal" resize="vertical_only" style="normal_unfocused"/>
  <frame focus="no" state="normal" resize="horizontal_only" style="normal_unfocused"/>
  <frame focus="no" state="normal" resize="none" style="normal_unfocused"/>
  <frame focus="no" state="shaded" resize="both" style="normal_unfocused"/>
  <frame focus="no" state="shaded" resize="vertical_only" style="normal_unfocused"/>
  <frame focus="no" state="shaded" resize="horizontal_only" style="normal_unfocused"/>
  <frame focus="no" state="shaded" resize="none" style="normal_unfocused"/>
  <frame focus="no" state="maximized" style="max_unfocused"/>
  <frame focus="no" state="maximized_and_shaded" style="max_unfocused"/>
</frame_style_set>
<frame_style_set name="border">
  <frame focus="yes" state="normal" resize="both" style="border_focused"/>
  <frame focus="yes" state="normal" resize="vertical_only" style="border_focused"/>
  <frame focus="yes" state="normal" resize="horizontal_only" style="border_focused"/>
  <frame focus="yes" state="normal" resize="none" style="border_focused"/>
  <frame focus="yes" state="shaded" resize="both" style="border_focused"/>
  <frame focus="yes" state="shaded" resize="vertical_only" style="border_focused"/>
  <frame focus="yes" state="shaded" resize="horizontal_only" style="border_focused"/>
  <frame focus="yes" state="shaded" resize="none" style="border_focused"/>
  <frame focus="yes" state="maximized" style="border_focused"/>
  <frame focus="yes" state="maximized_and_shaded" style="border_focused"/>
  <frame focus="no" state="normal" resize="both" style="border_unfocused"/>
  <frame focus="no" state="normal" resize="vertical_only" style="border_unfocused"/>
  <frame focus="no" state="normal" resize="horizontal_only" style="border_unfocused"/>
  <frame focus="no" state="normal" resize="none" style="border_unfocused"/>
  <frame focus="no" state="shaded" resize="both" style="border_unfocused"/>
  <frame focus="no" state="shaded" resize="vertical_only" style="border_unfocused"/>
  <frame focus="no" state="shaded" resize="horizontal_only" style="border_unfocused"/>
  <frame focus="no" state="shaded" resize="none" style="border_unfocused"/>
  <frame focus="no" state="maximized" style="border_unfocused"/>
  <frame focus="no" state="maximized_and_shaded" style="border_unfocused"/>
</frame_style_set>
<window type="normal" style_set="normal"/>
<window type="dialog" style_set="normal"/>
<window type="modal_dialog" style_set="normal"/>
<window type="menu" style_set="normal"/>
<window type="utility" style_set="normal"/>
<window type="border" style_set="border"/>
</metacity_theme>
