[Icon Theme]
Name=Winedows
Comment=Winedows desktop icons (generated by scripts/gen-icons.py)
Inherits=Papirus,hicolor
Directories=scalable/apps,scalable/devices,scalable/mimetypes,scalable/places

[scalable/apps]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/devices]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/places]
Size=256
MinSize=16
MaxSize=512
Type=Scalable
Context=Places
