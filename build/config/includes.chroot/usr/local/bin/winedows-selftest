#!/bin/sh
# Boot-time self test; only runs with winedows.selftest on the kernel cmdline.
out=/dev/ttyS0
say() { echo "$*" > "$out"; }
if command -v apt >/dev/null 2>&1 || command -v apt-get >/dev/null 2>&1 \
   || [ -e /etc/apt/sources.list ]; then say "SELFTEST apt=PRESENT"; else say "SELFTEST apt=absent"; fi
t=/usr/share/winedows/tests
# live-config creates the user; give it a moment, and say so if it never appears
for _ in $(seq 1 30); do id user >/dev/null 2>&1 && break; sleep 2; done
id user >/dev/null 2>&1 || say "SELFTEST diag: no 'user' account"
run() { su user -c "env WINEDEBUG=-all WINEDLLOVERRIDES=mscoree,mshtml= timeout 300 wine $1" > /tmp/selftest.out 2>&1; }
check() {
  run "$t/$2.exe"
  if grep -q WINEDOWS_EXE_OK /tmp/selftest.out; then say "SELFTEST $1=ok"; else
    say "SELFTEST $1=FAIL"
    tail -n 15 /tmp/selftest.out | sed "s/^/SELFTEST diag $1: /" > "$out"
  fi
}
check wine64 cli64
check wine32 cli32
[ "$(xdg-mime query default application/x-ms-dos-executable)" = winedows-run.desktop ] \
  && say "SELFTEST mime=ok" || say "SELFTEST mime=FAIL"
# no terminal: a command line is something you have to download as an .exe
term=""
for c in gnome-terminal xterm x-terminal-emulator uxterm konsole xfce4-terminal lxterminal mate-terminal tilix kgx; do
  command -v "$c" >/dev/null 2>&1 && term="$term $c"
done
if [ -z "$term" ]; then say "SELFTEST terminal=absent"; else say "SELFTEST terminal=PRESENT:$term"; fi
# what people read says Winedows (Debian only in technical details such as ID=)
b=""
grep -qi debian /etc/issue && b="$b issue"
grep -i '^PRETTY_NAME=' /etc/os-release | grep -qi debian && b="$b os-release"
grep -qil debian /usr/share/winedows/wallpapers/*.svg /usr/share/winedows/start.html && b="$b wallpaper/start"
ls /usr/share/winedows/wallpapers/*.svg >/dev/null 2>&1 || b="$b no-wallpapers"
grep -qi '^Name=Edgy' /usr/share/applications/firefox-esr.desktop || b="$b edgy-name"
for i in devices/computer places/user-trash places/folder-documents devices/network-wireless mimetypes/application-x-ms-dos-executable; do
  [ -f "/usr/share/icons/Winedows/scalable/$i.svg" ] || b="$b icon:$i"
done
if [ -z "$b" ]; then say "SELFTEST branding=ok"; else say "SELFTEST branding=FAIL:$b"; fi
# Desktop: launchers present, Command Prompt gone, .exe not executable (Nemo must hand it to Wine)
d=/etc/skel/Desktop
dk=""
for f in "This PC.desktop" Documents.desktop "Recycle Bin.desktop" Edgy.desktop Wi-Fi.desktop "Totally Native Linux App.exe"; do [ -e "$d/$f" ] || dk="$dk missing:$f"; done
[ -e "$d/Command Prompt.desktop" ] && dk="$dk command-prompt"
# "Install Winedows" only on the live system; the installed one has nothing left to install
if [ -d /run/live/medium ] || grep -qw 'boot=live' /proc/cmdline; then
  system=live
  [ -e "$d/Install Winedows.desktop" ] || dk="$dk missing:installer"
else
  system=installed
  [ -e "$d/Install Winedows.desktop" ] && dk="$dk installer-on-installed"
  [ -e /home/user/Desktop/Edgy.desktop ] || dk="$dk no-home-desktop"
fi
say "SELFTEST system=$system root=$(findmnt -no SOURCE / 2>/dev/null)"
for f in "$d"/*.exe; do [ -x "$f" ] && dk="$dk executable:$(basename "$f")"; done
if [ -z "$dk" ]; then say "SELFTEST desktop=ok"; else say "SELFTEST desktop=FAIL:$dk"; fi
say "WINEDOWS_SELFTEST_DONE"
