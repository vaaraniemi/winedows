#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib" \
  --debian-installer none \
  --binary-image iso-hybrid \
  --bootloaders "grub-pc,grub-efi" \
  --apt-recommends false \
  --apt-indices false \
  --security true \
  --updates true \
  --iso-volume WINEDOWS \
  --iso-application "Winedows" \
  --iso-publisher "Winedows Project; parody" \
  --bootappend-live "boot=live components quiet splash username=user hostname=winedows" \
  --memtest none \
  "${@}"
